# Configuración para AWS URL Shortener
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=url_shortener_links

# Reemplaza con la IP pública de tu instancia EC2 al desplegar
BASE_URL=http://<IP_PUBLICA_EC2>:8000

# Orígenes CORS permitidos (puede ser la URL de tu bucket S3 o * para pruebas)
CORS_ORIGINS=*

# Opcional: solo para pruebas locales con DynamoDB Local o LocalStack
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
